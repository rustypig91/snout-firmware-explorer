<?xml version="1.0" encoding="windows-1252"?>
<!--
  WiX v3 source for the Rusty's Snout - Firmware Explorer MSI package.

  Built in CI by calling candle/light directly (see .github/workflows/build.yml),
  and locally by `cargo wix -p snout`, which looks for this file at this path.
  Both define the same preprocessor variables:

    Version           the workspace version, e.g. 0.0.1
    Platform          x64
    CargoTargetBinDir directory holding the freshly built snout.exe
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

    <?if $(var.Platform) = x64 ?>
        <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
    <?else ?>
        <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
    <?endif ?>

    <Product
        Id="*"
        Name="Rusty's Snout - Firmware Explorer"
        UpgradeCode="A62F6D56-6973-4C6D-ACD8-4599E331C313"
        Manufacturer="Christoffer Zakrisson"
        Language="1033"
        Codepage="1252"
        Version="$(var.Version)">

        <Package Id="*"
            Keywords="Installer"
            Description="Rusty's Snout - Firmware Explorer"
            Manufacturer="Christoffer Zakrisson"
            InstallerVersion="450"
            Languages="1033"
            Compressed="yes"
            InstallScope="perMachine"
            SummaryCodepage="1252" />

        <!-- Installing a new version uninstalls the old one in place, so users
             never end up with two entries in Add/Remove Programs. -->
        <MajorUpgrade
            Schedule="afterInstallInitialize"
            DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit." />

        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1" />
        <Property Id="DiskPrompt" Value="Rusty's Snout - Firmware Explorer Installation" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="$(var.PlatformProgramFilesFolder)" Name="PFiles">
                <Directory Id="APPLICATIONFOLDER" Name="Rusty's Snout - Firmware Explorer">

                    <Component Id="MainExecutable" Guid="*">
                        <File
                            Id="SnoutExe"
                            Name="snout.exe"
                            DiskId="1"
                            Source="$(var.CargoTargetBinDir)\snout.exe"
                            KeyPath="yes">
                            <Shortcut
                                Id="StartMenuShortcut"
                                Directory="ProgramMenuFolder"
                                Name="Rusty's Snout - Firmware Explorer"
                                Description="Rustys Snout - Firmware Explorer"
                                WorkingDirectory="APPLICATIONFOLDER"
                                Advertise="yes"
                                Icon="SnoutIcon.exe" IconIndex="0" />
                        </File>
                    </Component>

                    <Component Id="LicenseFile" Guid="*">
                        <File
                            Id="License"
                            Name="License.rtf"
                            DiskId="1"
                            Source="$(sys.SOURCEFILEDIR)..\packaging\windows\License.rtf"
                            KeyPath="yes" />
                    </Component>

                </Directory>
            </Directory>

            <!-- Target of the advertised Start Menu shortcut above. -->
            <Directory Id="ProgramMenuFolder" Name="Programs" />
        </Directory>

        <Feature
            Id="Complete"
            Title="Rusty's Snout - Firmware Explorer"
            Description="Rusty's Snout - Firmware Explorer application."
            Level="1"
            ConfigurableDirectory="APPLICATIONFOLDER"
            AllowAdvertise="no"
            Display="expand"
            Absent="disallow">
            <ComponentRef Id="MainExecutable" />
            <ComponentRef Id="LicenseFile" />
        </Feature>

        <!-- Icon shown in Add/Remove Programs and on the Start Menu shortcut. -->
        <Icon Id="SnoutIcon.exe" SourceFile="$(var.CargoTargetBinDir)\snout.exe" />
        <Property Id="ARPPRODUCTICON" Value="SnoutIcon.exe" />
        <Property Id="ARPHELPLINK" Value="https://github.com/rustypig91/snout-firmware-explorer" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/rustypig91/snout-firmware-explorer" />

        <!-- Welcome → license → install directory → progress → finish. -->
        <UIRef Id="WixUI_InstallDir" />
        <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
        <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)..\packaging\windows\License.rtf" />

    </Product>
</Wix>
